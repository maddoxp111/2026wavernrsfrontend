{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/album",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Discordbot|Twitterbot|facebookexternalhit|facebookcatalog|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Googlebot|bingbot|redditbot|Applebot|Iframely|SkypeUriPreview|Embedly|Pinterest|Mastodon|DuckDuckBot|YandexBot|vkShare).*" }],
      "destination": "/api/og?type=album"
    },
    {
      "source": "/track",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Discordbot|Twitterbot|facebookexternalhit|facebookcatalog|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Googlebot|bingbot|redditbot|Applebot|Iframely|SkypeUriPreview|Embedly|Pinterest|Mastodon|DuckDuckBot|YandexBot|vkShare).*" }],
      "destination": "/api/og?type=track"
    },
    {
      "source": "/artist",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Discordbot|Twitterbot|facebookexternalhit|facebookcatalog|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Googlebot|bingbot|redditbot|Applebot|Iframely|SkypeUriPreview|Embedly|Pinterest|Mastodon|DuckDuckBot|YandexBot|vkShare).*" }],
      "destination": "/api/og?type=artist"
    },
    {
      "source": "/playlist",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Discordbot|Twitterbot|facebookexternalhit|facebookcatalog|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Googlebot|bingbot|redditbot|Applebot|Iframely|SkypeUriPreview|Embedly|Pinterest|Mastodon|DuckDuckBot|YandexBot|vkShare).*" }],
      "destination": "/api/og?type=playlist"
    }
  ]
}
