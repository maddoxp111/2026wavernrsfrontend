{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/album.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Discordbot|Twitterbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|redditbot|Iframely|embedly|Applebot|Pinterest|vkShare|SkypeUriPreview|Mastodon|Bluesky|Snapchat|Yeti|Google-InspectionTool).*"
        }
      ],
      "destination": "https://2026wavernrs-production.up.railway.app/api/og/album"
    },
    {
      "source": "/track.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Discordbot|Twitterbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|redditbot|Iframely|embedly|Applebot|Pinterest|vkShare|SkypeUriPreview|Mastodon|Bluesky|Snapchat|Yeti|Google-InspectionTool).*"
        }
      ],
      "destination": "https://2026wavernrs-production.up.railway.app/api/og/track"
    },
    {
      "source": "/artist.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Discordbot|Twitterbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|redditbot|Iframely|embedly|Applebot|Pinterest|vkShare|SkypeUriPreview|Mastodon|Bluesky|Snapchat|Yeti|Google-InspectionTool).*"
        }
      ],
      "destination": "https://2026wavernrs-production.up.railway.app/api/og/artist"
    },
    {
      "source": "/archive-artist.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Discordbot|Twitterbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|redditbot|Iframely|embedly|Applebot|Pinterest|vkShare|SkypeUriPreview|Mastodon|Bluesky|Snapchat|Yeti|Google-InspectionTool).*"
        }
      ],
      "destination": "https://2026wavernrs-production.up.railway.app/api/og/archive-artist"
    },
    {
      "source": "/games",
      "destination": "/games.html"
    }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}